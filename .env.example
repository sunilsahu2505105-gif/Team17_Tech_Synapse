# Backend
PORT=3000
JWT_SECRET=change-me-in-real-use

# AI (optional)
# If you set OPENAI_API_KEY, caregiver dashboard chat + image understanding routes will work.
GEMINI_API_KEY=

# Optional: override base URL (proxy / Azure OpenAI compatible gateway)
OPENAI_BASE_URL=

# Optional model selection
GEMINI_MODEL_CHAT=gemini-1.5-flash
GEMINI_MODEL_VISION=gemini-1.5-flash

# YOLOv8 (optional)
# Enables POST /api/detect (requires Python + ultralytics)
YOLO_PYTHON=python
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.25
